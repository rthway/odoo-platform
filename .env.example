# ===========================================================================
# Odoo DevOps Platform - environment reference
# ===========================================================================
# This file is the CANONICAL LIST of every variable the stack reads. It is
# committed; it contains PLACEHOLDERS ONLY and must never hold a real value.
#
# Real values live in:
#   - a .env file on each server, rendered by Ansible (mode 0600), or
#   - GitHub Environment Secrets (dev / qa / production) for CI/CD.
#
# Generate strong values with:  ./scripts/gen-secrets.sh
# ===========================================================================

# --- Identity -------------------------------------------------------------
# One project name per environment keeps container/volume/network names
# distinct, so DEV, QA and PROD can never collide on a shared host.
COMPOSE_PROJECT_NAME=odoo-dev
ENVIRONMENT=dev

# --- Image (Docker Hub) ---------------------------------------------------
# BUILD ONCE, PROMOTE THE SAME IMAGE. DEV, QA and PROD must all run the exact
# same ODOO_IMAGE_TAG. Never use `latest` outside a scratch environment.
ODOO_IMAGE=docker.io/rthway/odoo-platform
ODOO_IMAGE_TAG=

# Pinned base image versions. Bumped deliberately, never floating.
ODOO_VERSION=18.0-20260817
POSTGRES_VERSION=16.15-alpine3.24
NGINX_VERSION=1.31.4-alpine3.24

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Odoo's own database (Odoo manages it; POSTGRES_DB is the bootstrap db).
ODOO_DB_NAME=
ODOO_DB_MAXCONN=

# --- Odoo -----------------------------------------------------------------
# Master password. Guards database create/drop/backup over HTTP.
ODOO_ADMIN_PASSWD=
# Workers: 0 = threaded mode (dev only). Production: (2 x vCPU) + 1.
ODOO_WORKERS=0
ODOO_MAX_CRON_THREADS=1
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560
ODOO_LIMIT_TIME_CPU=60
ODOO_LIMIT_TIME_REAL=120
ODOO_LIMIT_REQUEST=8192
# list_db=False hides the database manager. MUST be False in QA and PROD.
ODOO_LIST_DB=True
# proxy_mode=True is required whenever nginx terminates TLS in front of Odoo.
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL=info

# --- Ingress --------------------------------------------------------------
ODOO_DOMAIN=
# BIND_ADDRESS=127.0.0.1 keeps the stack private; only a reverse proxy or an
# SSH tunnel reaches it. Set 0.0.0.0 only when a firewall fronts the host.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Backup ---------------------------------------------------------------
BACKUP_DIR=/var/backups/odoo
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
# age public key (age1...) used to encrypt backups at rest. Public, safe here.
BACKUP_AGE_RECIPIENT=
# Off-site target for the third 3-2-1 copy. Empty = off-site DISABLED.
BACKUP_OFFSITE_TARGET=

# --- Observability --------------------------------------------------------
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
