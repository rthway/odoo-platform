# ===========================================================================
# RENDERED BY ANSIBLE - DO NOT EDIT ON THE SERVER
# ===========================================================================
# Any manual change here is silently overwritten on the next Ansible run,
# and creates drift between what the repository says and what is running.
# Host: {{ inventory_hostname }}   Environment: {{ env_name }}
# ===========================================================================

COMPOSE_PROJECT_NAME=odoo-{{ env_name }}
ENVIRONMENT={{ env_name }}

ODOO_IMAGE={{ odoo_image | default('docker.io/rthway/odoo-platform') }}
ODOO_IMAGE_TAG={{ odoo_image_tag | default('') }}

ODOO_VERSION={{ odoo_version | default('18.0-20260817') }}
POSTGRES_VERSION={{ postgres_version | default('16.15-alpine3.24') }}
NGINX_VERSION={{ nginx_version | default('1.31.4-alpine3.24') }}

POSTGRES_DB=odoo_{{ env_name }}
POSTGRES_USER=odoo_{{ env_name }}
POSTGRES_PASSWORD={{ postgres_password }}
ODOO_DB_NAME=odoo_{{ env_name }}
ODOO_DB_MAXCONN={{ odoo_db_maxconn | default(64) }}

ODOO_ADMIN_PASSWD={{ odoo_admin_passwd }}
ODOO_WORKERS={{ odoo_workers | default(0) }}
ODOO_MAX_CRON_THREADS={{ odoo_max_cron_threads | default(1) }}
ODOO_LIMIT_MEMORY_SOFT={{ odoo_limit_memory_soft | default(2147483648) }}
ODOO_LIMIT_MEMORY_HARD={{ odoo_limit_memory_hard | default(2684354560) }}
ODOO_LIMIT_TIME_CPU={{ odoo_limit_time_cpu | default(60) }}
ODOO_LIMIT_TIME_REAL={{ odoo_limit_time_real | default(120) }}
ODOO_LIMIT_REQUEST={{ odoo_limit_request | default(8192) }}

{# The database manager is permitted in DEV only. The container entrypoint
   independently refuses to start if this is True outside dev. #}
ODOO_LIST_DB={{ 'True' if env_name == 'dev' else 'False' }}
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL={{ odoo_log_level | default('info') }}

ODOO_DOMAIN={{ odoo_domain }}
BIND_ADDRESS={{ bind_address | default('0.0.0.0') }}
{# 80/443 in every environment. DEV and QA previously used 8080/8443, which
   meant every URL carried a port, the HTTP->HTTPS redirect had to be
   port-aware, and DEV did not resemble production at the one layer users
   actually touch. #}
HTTP_PORT={{ http_port | default(80) }}
HTTPS_PORT={{ https_port | default(443) }}
{# The port the HTTP->HTTPS redirect must send browsers to. Empty on 443 so
   production redirects to a clean https://host/ URL; ":8443" elsewhere,
   because $host in nginx carries no port and the redirect would otherwise
   point at a port that is not published. #}
{% set _hp = https_port | default(443) %}
HTTPS_PUBLIC_PORT={{ '' if _hp | int == 443 else ':' ~ _hp }}

BACKUP_DIR={{ backup_dir }}
BACKUP_RETENTION_DAILY={{ backup_retention_daily | default(7) }}
BACKUP_RETENTION_WEEKLY={{ backup_retention_weekly | default(4) }}
BACKUP_RETENTION_MONTHLY={{ backup_retention_monthly | default(6) }}
BACKUP_AGE_RECIPIENT={{ backup_age_recipient | default('') }}
BACKUP_OFFSITE_TARGET={{ backup_offsite_target | default('') }}

NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
