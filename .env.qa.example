# QA / UAT (157.10.100.230) - placeholders only. Copy to .env on the QA host.
# QA runs the EXACT image tag that passed DEV. It is never rebuilt.
COMPOSE_PROJECT_NAME=odoo-qa
ENVIRONMENT=qa
ODOO_IMAGE=docker.io/rthway/odoo-platform
ODOO_IMAGE_TAG=
# A dedicated database on a dedicated host. QA MUST NOT reach the PROD db.
POSTGRES_DB=odoo_qa
POSTGRES_USER=odoo_qa
POSTGRES_PASSWORD=
ODOO_DB_NAME=odoo_qa
ODOO_DB_MAXCONN=64
ODOO_ADMIN_PASSWD=
# Multi-worker so QA exercises the same concurrency model as production.
ODOO_WORKERS=3
ODOO_MAX_CRON_THREADS=1
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560
# Database manager disabled, matching production.
ODOO_LIST_DB=False
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL=info
ODOO_DOMAIN=odoo-qa.local
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
HTTPS_PORT=8443
BACKUP_DIR=/var/backups/odoo
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=2
BACKUP_RETENTION_MONTHLY=0
BACKUP_AGE_RECIPIENT=
