# PRODUCTION (157.10.100.231) - placeholders only.
# Values come from GitHub Environment Secrets in the `production` environment,
# rendered to /opt/odoo-platform/.env (0600, root) by Ansible. Never by hand.
COMPOSE_PROJECT_NAME=odoo-prod
ENVIRONMENT=prod
ODOO_IMAGE=docker.io/rthway/odoo-platform
# Pin an immutable tag or, better, a digest. Never `latest`.
ODOO_IMAGE_TAG=
POSTGRES_DB=odoo_prod
POSTGRES_USER=odoo_prod
POSTGRES_PASSWORD=
ODOO_DB_NAME=odoo_prod
ODOO_DB_MAXCONN=64
ODOO_ADMIN_PASSWD=
# (2 x vCPU) + 1. Confirm against `nproc` on .231 before setting.
ODOO_WORKERS=5
ODOO_MAX_CRON_THREADS=2
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560
ODOO_LIMIT_TIME_CPU=60
ODOO_LIMIT_TIME_REAL=120
# MUST be False. True exposes database create/drop/restore over HTTP.
ODOO_LIST_DB=False
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL=warn
ODOO_DOMAIN=
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Port the HTTP->HTTPS redirect points at. Empty means 443.
HTTPS_PUBLIC_PORT=
BACKUP_DIR=/var/backups/odoo
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
BACKUP_AGE_RECIPIENT=
# REQUIRED in production: 3-2-1 needs a copy outside this infrastructure.
BACKUP_OFFSITE_TARGET=
