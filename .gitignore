# ---------------------------------------------------------------------------
# Secrets. Nothing matching these patterns may ever reach the repository.
# Only *.example files are tracked; they carry placeholders, never values.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.dev.example
!.env.qa.example
!.env.prod.example
secrets/
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*.age
*.gpg

# TLS material generated on the host
config/nginx/tls/*
!config/nginx/tls/.gitkeep

# Ansible inventories hold real hostnames and users
infrastructure/ansible/inventory/*.ini
!infrastructure/ansible/inventory/*.example.ini
infrastructure/ansible/*.retry

# Runtime state written by deploy/rollback
.deploy-state/
backups/
*.dump
*.sql.gz
*.tar.zst

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Odoo runtime
addons/**/*.pyc
.odoo-filestore/
sessions/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
