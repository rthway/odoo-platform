# OPS / monitoring host (157.10.100.232) - placeholders only.
# Used by compose.observability.yml. Copy to .env on the OPS host.
COMPOSE_PROJECT_NAME=odoo-observability
ENVIRONMENT=ops

# --- Pinned versions ------------------------------------------------------
PROMETHEUS_VERSION=v3.1.0
ALERTMANAGER_VERSION=v0.28.0
LOKI_VERSION=3.3.2
GRAFANA_VERSION=11.5.1
BLACKBOX_VERSION=v0.26.0
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.52.1

# --- Binding --------------------------------------------------------------
# 127.0.0.1 deliberately. None of these has authentication strong enough to
# face the internet; they are reached over an SSH tunnel. Changing this to
# 0.0.0.0 publishes an unauthenticated Prometheus and Alertmanager.
MONITORING_BIND=127.0.0.1
# Loki must accept pushes from DEV, QA and PROD, so it cannot bind to
# localhost like the dashboards do. Set to this host's internal address;
# ufw restricts port 3100 to the application hosts.
LOKI_BIND=192.168.2.56
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
GRAFANA_PORT=3000

# --- Retention ------------------------------------------------------------
PROMETHEUS_RETENTION=30d

# --- Grafana --------------------------------------------------------------
# Required: compose refuses to start without them, rather than defaulting to
# admin/admin.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Grafana is served by nginx on 443, so this must say https or Grafana
# generates http:// links and redirects behind TLS.
GRAFANA_ROOT_URL=https://157.10.100.232
GRAFANA_DOMAIN=157.10.100.232

# --- Public ingress on OPS ------------------------------------------------
# nginx fronts GRAFANA ONLY on 80/443. Prometheus and Alertmanager stay on
# MONITORING_BIND (localhost) because neither has any authentication.
OPS_BIND=0.0.0.0
OPS_HTTP_PORT=80
OPS_HTTPS_PORT=443
NGINX_VERSION=1.31.4-alpine3.24
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# --- Alert delivery -------------------------------------------------------
SMTP_SMARTHOST=
SMTP_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_CRITICAL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_SLACK_CHANNEL=
ALERT_SLACK_CHANNEL_CRITICAL=
ALERT_SLACK_CHANNEL_LOW=
