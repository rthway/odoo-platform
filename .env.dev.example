# DEV (157.10.100.223) - placeholders only. Copy to .env on the DEV host.
# Deployment is automatic on every merge to develop.
COMPOSE_PROJECT_NAME=odoo-dev
ENVIRONMENT=dev
ODOO_IMAGE=docker.io/rthway/odoo-platform
ODOO_IMAGE_TAG=
POSTGRES_DB=odoo_dev
POSTGRES_USER=odoo_dev
POSTGRES_PASSWORD=
ODOO_DB_NAME=odoo_dev
ODOO_DB_MAXCONN=32
ODOO_ADMIN_PASSWD=
# Threaded mode: a single worker makes tracebacks and debugging linear.
ODOO_WORKERS=0
ODOO_MAX_CRON_THREADS=1
# The database manager stays reachable in DEV so developers can rebuild.
ODOO_LIST_DB=True
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL=debug
ODOO_DOMAIN=odoo-dev.local
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Port the HTTP->HTTPS redirect points at. Empty means 443.
HTTPS_PUBLIC_PORT=
BACKUP_DIR=/var/backups/odoo
BACKUP_RETENTION_DAILY=3
BACKUP_RETENTION_WEEKLY=1
BACKUP_RETENTION_MONTHLY=0
BACKUP_AGE_RECIPIENT=
